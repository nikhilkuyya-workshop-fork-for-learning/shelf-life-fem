            "size": -1,
            "mimeType": "text/javascript",
            "text": "export const shelfStatuses = [\n\t\"to-read\",\n\t\"reading\",\n\t\"finished\"\n];\nexport const shelfStatusLabels = {\n\t\"to-read\": \"To read\",\n\treading: \"Reading\",\n\tfinished: \"Finished\"\n};\nexport const calculateShelfSummary = (entries) => {\n\tconst summary = {\n\t\ttotalBooks: entries.length,\n\t\treadingCount: entries.filter((entry) => entry.status === \"reading\").length,\n\t\tfinishedCount: entries.filter((entry) => entry.status === \"finished\").length,\n\t\taverageRating: null\n\t};\n\tconst ratings = entries.map((entry) => entry.rating).filter((rating) => rating !== null);\n\tif (ratings.length > 0) {\n\t\tconst totalRating = ratings.reduce((runningTotal, rating) => runningTotal + rating, 0);\n\t\tsummary.averageRating = Number((totalRating / ratings.length).toFixed(1));\n\t}\n\treturn summary;\n};\n\n//# sourceMappingURL=data:application/json;base64,"
